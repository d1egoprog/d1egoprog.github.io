---
import MainLayout from "../layouts/MainLayout.astro";
import { sitePath } from "../lib/urls";
import { courseModules, courseResources, resourceCategories } from "../data/datascience-basic";

const concepts = [
    { term: "Data & metadata", text: "Data records observations. Metadata explains those observations: what a variable means, its units, where it came from, and how it was collected.", example: "A value of 42 needs a variable name and a unit to be useful." },
    { term: "Data structure", text: "Tables follow a predefined schema. JSON and XML organize semi-structured records. Text, images, and audio need other methods to extract useful features.", example: "A survey table and its free-text responses need different preparation." },
    { term: "ETL & data quality", text: "Extract data from a source, transform it into a consistent form, then load it for use. Inspect missing values, duplicates, units, and unexpected values along the way.", example: "Keep the raw file and record each change in a cleaning log." },
    { term: "Descriptive & predictive analysis", text: "Descriptive analysis summarizes what you observed. Predictive analysis learns patterns to estimate outcomes for new observations and needs evaluation on unseen data.", example: "Summarizing past counts and predicting a future count answer different questions." },
    { term: "FAIR research data", text: "Findable, Accessible, Interoperable, Reusable. Useful metadata, clear access conditions, shared formats, and explicit reuse conditions help others work with your data.", example: "Package a dataset with a data dictionary, its origin, and a license." },
    { term: "Text as data", text: "A corpus is a collection of documents. Tokenization splits text into units. A bag of words counts terms while leaving out word order and much of the context.", example: "Removing “not” can change the meaning of “not good”." },
];
const formats = [
    { name: "CSV", description: "A table with a header and one record per row. Check the delimiter and encoding when importing.", code: 'sample_id,site,count\nS01,North,12\nS02,South,9' },
    { name: "JSON", description: "Objects and arrays can express nested records. JSON keys and string values use double quotes.", code: '[\n  {"sample_id": "S01", "site": "North", "count": 12},\n  {"sample_id": "S02", "site": "South", "count": 9}\n]' },
    { name: "XML", description: "Named tags describe elements and their hierarchy. Each record contains the same observations as the CSV and JSON examples.", code: '<samples>\n  <sample id="S01"><site>North</site><count>12</count></sample>\n  <sample id="S02"><site>South</site><count>9</count></sample>\n</samples>' },
];
---

<MainLayout
    title="Data Science Basics"
    description="Data science and data management for doctoral research. Explore the course topics, foundational concepts, practical exercises, and a library of course resources."
    pageType="CollectionPage"
>
    <div class="course-page" id="course-top">
        <div class="container">
            <a class="course-back" href={sitePath("teaching/")}><span aria-hidden="true">←</span> Teaching</a>
            <header class="course-hero">
                <div>
                    <p class="eyebrow">datascience-basic</p>
                    <h1>Data Science<br /><span>for doctoral research</span></h1>
                    <p class="hero-description">A practical introduction to understanding, preparing, and learning from data. Connect the core concepts to your own research question.</p>
                    <div class="hero-actions">
                        <a class="course-button" href="#course-outline">Explore the course <span aria-hidden="true">↓</span></a>
                        <a class="text-link" href="#resources">Browse resources <span aria-hidden="true">↗</span></a>
                    </div>
                </div>
                <aside class="course-note" aria-label="Course information">
                    <span class="note-index" aria-hidden="true">01 / RESEARCH NOTEBOOK</span>
                    <h2>A question.<br /> A dataset.<br /> An informed conclusion.</h2>
                    <p>Bring a question from your field. Work through the choices that make data useful as research evidence.</p>
                    <dl>
                        <div><dt>Instructor</dt><dd>Diego Rincon-Yanez</dd></div>
                        <div><dt>Focus</dt><dd>Data science & data management</dd></div>
                        <div><dt>Approach</dt><dd>Concepts + hands-on practice</dd></div>
                    </dl>
                </aside>
            </header>
        </div>

        <nav class="course-nav" aria-label="On this page">
            <div class="container course-nav-inner">
                <span>On this page</span>
                <a href="#overview">Overview</a>
                <a href="#course-outline">Course outline</a>
                <a href="#concepts">Key concepts</a>
                <a href="#practice">Practice</a>
                <a href="#resources">Resources</a>
            </div>
        </nav>

        <div class="container course-content">
            <section class="course-section overview-section" id="overview" aria-labelledby="overview-heading">
                <div class="section-intro">
                    <p class="eyebrow">The starting point</p>
                    <h2 id="overview-heading">Good research starts<br /> with understanding your data</h2>
                </div>
                <div class="overview-copy">
                    <p>This course brings together the foundations of data science and the practical work of data management. We begin with a research question, examine the data behind it, and explore how analysis can support a defensible interpretation.</p>
                    <p>You will work with data formats, cleaning decisions, introductory AI, and text analysis. Documentation, visualization, and responsible reuse run through the course.</p>
                    <h3>What you will practice</h3>
                    <ul class="check-list">
                        <li>Describe a dataset, its origin, and its limitations.</li>
                        <li>Recognize common formats and prepare data for analysis.</li>
                        <li>Explain the purpose of a model and how to evaluate it.</li>
                        <li>Communicate a simple analysis with a clear chart and reproducible steps.</li>
                    </ul>
                    <p class="course-expectation"><strong>Before you begin:</strong> bring basic computer skills, an interest in research, and a willingness to experiment. The practical work introduces Python and notebooks step by step.</p>
                </div>
            </section>

            <section class="course-section" id="course-outline" aria-labelledby="outline-heading">
                <div class="section-heading">
                    <div><p class="eyebrow">The learning path</p><h2 id="outline-heading">Course outline</h2></div>
                    <p>Five topics, with a research activity for each. Open a topic to see what we will cover.</p>
                </div>
                <div class="module-list">
                    {courseModules.map((module, index) => (
                        <details class="course-module" open={index === 0}>
                            <summary>
                                <span class="module-number">{module.number}</span>
                                <span class="module-title"><strong>{module.title}</strong><span>{module.summary}</span></span>
                                <span class="module-toggle" aria-hidden="true"></span>
                            </summary>
                            <div class="module-body">
                                <p class="module-topics">{module.topics}</p>
                                <p>{module.learning}</p>
                                <p><strong>Research activity.</strong> {module.activity}</p>
                                <a class="text-link" href={`#resource-${module.resource}`}>Find the slides in resources <span aria-hidden="true">↗</span></a>
                            </div>
                        </details>
                    ))}
                </div>
            </section>

            <section class="course-section" id="concepts" aria-labelledby="concepts-heading">
                <div class="section-heading">
                    <div><p class="eyebrow">A quick reference</p><h2 id="concepts-heading">A few ideas to keep close</h2></div>
                    <p>Short explanations of the concepts we will return to throughout the course.</p>
                </div>
                <dl class="concept-grid">
                    {concepts.map((concept, index) => (
                        <div class="concept">
                            <dt><span aria-hidden="true">0{index + 1}</span>{concept.term}</dt>
                            <dd><p>{concept.text}</p><p class="concept-example">{concept.example}</p></dd>
                        </div>
                    ))}
                </dl>

                <div class="format-lab">
                    <div class="format-intro">
                        <p class="eyebrow">Look inside a file</p>
                        <h3>Same observations.<br /> Different formats.</h3>
                        <p>These two fictional sample records hold the same information. The format changes how you read and organize it.</p>
                    </div>
                    <div class="format-examples">
                        {formats.map((format, index) => (
                            <details class="format-example" open={index === 0}>
                                <summary>{format.name}<span aria-hidden="true">+</span></summary>
                                <p>{format.description}</p>
                                <pre><code>{format.code}</code></pre>
                            </details>
                        ))}
                    </div>
                </div>
            </section>

            <section class="course-section" id="practice" aria-labelledby="practice-heading">
                <div class="section-heading">
                    <div><p class="eyebrow">Learning by doing</p><h2 id="practice-heading">Put the concepts to work</h2></div>
                    <p>Use a small dataset you are allowed to work with. Keep a record of your choices as you go.</p>
                </div>
                <ol class="practice-list">
                    <li><span class="practice-number" aria-hidden="true">01</span><div><h3>Inspect a file</h3><p>Compare the CSV, DSV, JSON, and XML examples. Identify the records, fields, delimiter, and encoding. Write down what you can and cannot infer from the file alone.</p><a class="text-link" href="#resource-dataset-csv">File examples <span aria-hidden="true">↗</span></a></div><span class="practice-label">EXPLORE</span></li>
                    <li><span class="practice-number" aria-hidden="true">02</span><div><h3>Prepare a reusable dataset</h3><p>Inspect missing values, duplicates, and inconsistent labels. Preserve the original file and document your changes. Add a data dictionary, a short README, and clear access and reuse conditions.</p><p class="practice-output"><strong>Keep:</strong> a CSV, its documentation, and a cleaning log.</p></div><span class="practice-label">PREPARE</span></li>
                    <li><span class="practice-number" aria-hidden="true">03</span><div><h3>Take text from a DSV file to a chart</h3><p>Use a Python notebook to load a text column with pandas. Inspect and tokenize the text, compare stopword choices, and count terms. Plot the frequencies and explain the limits of that representation.</p><a class="text-link" href="#resource-slides-practice">Python + NLP practice <span aria-hidden="true">↗</span></a></div><span class="practice-label">ANALYZE</span></li>
                </ol>
                <div class="research-check">
                    <h3>Before sharing your results</h3>
                    <p>Can another researcher understand the variables, follow your steps, and explain the limitations? Describe how you handled privacy and permission to use the data. Give each chart a clear title, labelled axes, and units where relevant.</p>
                </div>
            </section>

            <section class="course-section resource-section" id="resources" aria-labelledby="resources-heading">
                <div class="section-heading">
                    <div><p class="eyebrow">Keep learning</p><h2 id="resources-heading">Course resources</h2></div>
                    <p>Slides, file examples, code, and readings in one place.</p>
                </div>
                <p class="resource-notice"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span><strong>Download links are coming soon.</strong> The library reserves a place for each resource. Selected datasets, code, and readings carry over from the earlier Big Data course.</span></p>
                <div class="resource-filters" role="group" aria-label="Filter course resources" hidden>
                    <button type="button" data-resource-filter="all" aria-pressed="true">All resources <span>{courseResources.length}</span></button>
                    {resourceCategories.map((category) => (
                        <button type="button" data-resource-filter={category.id} aria-pressed="false">{category.label} <span>{courseResources.filter((resource) => resource.category === category.id).length}</span></button>
                    ))}
                </div>
                <p class="resource-status" id="resource-status" role="status" aria-live="polite" aria-atomic="true">Showing all {courseResources.length} resources.</p>
                <div class="resource-groups">
                    {resourceCategories.map((category) => (
                        <section class="resource-group" data-resource-group={category.id} aria-labelledby={`group-${category.id}`}>
                            <h3 id={`group-${category.id}`}>{category.label}</h3>
                            <ul class="resource-list">
                                {courseResources.filter((resource) => resource.category === category.id).map((resource) => (
                                    <li class="resource-row" id={`resource-${resource.id}`}>
                                        <span class="resource-format">{resource.format}</span>
                                        <div class="resource-description">
                                            <h4>{resource.title}</h4>
                                            <p>{resource.description}</p>
                                            <p class="resource-meta">{resource.origin}{resource.filename && <> <span aria-hidden="true">/</span> <code>{resource.filename}</code></>}</p>
                                        </div>
                                        {resource.href ? (
                                            <a class="resource-download" href={resource.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${resource.title}`}><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Open resource</a>
                                        ) : (
                                            <span class="resource-placeholder"><i class="fa-solid fa-clock" aria-hidden="true"></i> Link coming soon</span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    ))}
                </div>
            </section>

            <div class="course-end"><p>Bring your questions. Read, discuss, and practice.</p><a class="text-link" href="#course-top">Back to top <span aria-hidden="true">↑</span></a></div>
        </div>
    </div>
</MainLayout>

<style>
    .course-page { --ink: #263749; --muted: #576575; --blue: #24486e; --line: #ccd4dd; color: var(--ink); background: #f6f7f9; font-size: 15px; line-height: 1.75; }
    .course-page :is(section, li[id], div[id]) { scroll-margin-top: 84px; }
    .course-page h1, .course-page h2, .course-page h3, .course-page h4 { font-family: "Raleway", sans-serif; font-weight: 700; line-height: 1.25; }
    .course-page a { color: var(--blue); }
    .course-page a:hover { text-decoration: underline; }
    .course-page :is(a, button, summary):focus-visible { outline: 3px solid #315e90; outline-offset: 5px; }
    .course-back { display: inline-flex; gap: 8px; margin: 25px 0 26px; font-size: 13px; }
    .eyebrow { color: var(--blue); font-size: 11px; font-weight: 700; letter-spacing: 1.7px; text-transform: uppercase; margin-bottom: 15px; }
    .course-hero { display: grid; grid-template-columns: 1.45fr 1fr; gap: 70px; padding-bottom: 55px; align-items: center; }
    .course-hero h1 { font-size: clamp(32px, 3.6vw, 49px); letter-spacing: -1.4px; line-height: 1.15; }
    .course-hero h1 span { color: var(--blue); }
    .hero-description { max-width: 550px; color: var(--muted); margin: 24px 0 28px; font-size: 17px; }
    .hero-actions { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; }
    .course-button { display: inline-flex; align-items: center; gap: 25px; background: var(--blue); color: #fff !important; font-weight: 700; padding: 12px 18px; font-size: 13px; }
    .course-button:hover { background: #1b3856; text-decoration: none !important; }
    .text-link { font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; gap: 9px; }
    .course-note { background: #e7edf5; border-top: 3px solid #7d9fd3; padding: 25px 28px; }
    .note-index { display: block; font-size: 10px; color: #526780; letter-spacing: 1px; margin-bottom: 20px; }
    .course-note h2 { font-size: 25px; line-height: 1.35; margin-bottom: 17px; }
    .course-note > p { color: var(--muted); font-size: 13px; line-height: 1.7; margin-bottom: 20px; }
    .course-note dl { margin: 0; border-top: 1px solid #c5cfdb; padding-top: 14px; font-size: 11px; line-height: 1.7; }
    .course-note dl div { display: grid; grid-template-columns: 85px 1fr; gap: 10px; padding: 3px 0; }
    .course-note dt { color: #526175; font-weight: 400; }
    .course-note dd { font-weight: 700; margin: 0; }
    .course-nav { position: sticky; top: 0; z-index: 20; background: #fff; border-block: 1px solid var(--line); }
    .course-nav-inner { display: flex; align-items: center; gap: 30px; min-height: 60px; flex-wrap: wrap; }
    .course-nav span { color: #697584; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin-right: auto; }
    .course-nav a { font-size: 12px; font-weight: 700; padding-block: 15px; }
    .course-section { padding: 64px 0; border-bottom: 1px solid var(--line); }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 50px; margin-bottom: 30px; }
    .section-heading h2, .section-intro h2 { font-size: 29px; letter-spacing: -0.5px; }
    .section-heading > p { color: var(--muted); max-width: 390px; font-size: 13px; }
    .overview-section { display: grid; grid-template-columns: 1fr 1.3fr; gap: 65px; }
    .overview-copy > p { margin-bottom: 18px; color: var(--muted); }
    .overview-copy h3 { font-size: 17px; margin: 25px 0 15px; }
    .check-list { margin: 0 0 24px; }
    .check-list li { position: relative; padding-left: 22px; margin-bottom: 9px; font-size: 13px; }
    .check-list li::before { content: "✓"; position: absolute; left: 0; color: var(--blue); }
    .overview-copy .course-expectation { font-size: 12px; margin-bottom: 0; }
    .course-module { border-top: 1px solid var(--line); }
    .course-module:last-child { border-bottom: 1px solid var(--line); }
    .course-module summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 22px; padding: 22px 5px; }
    .course-module summary::-webkit-details-marker, .format-example summary::-webkit-details-marker { display: none; }
    .module-number { font-size: 12px; font-weight: 700; color: var(--blue); width: 35px; flex-shrink: 0; }
    .module-title { display: grid; gap: 5px; }
    .module-title strong { font-size: 18px; }
    .module-title > span { color: var(--muted); font-size: 12px; }
    .module-toggle { margin-left: auto; width: 25px; flex-shrink: 0; color: var(--blue); text-align: center; font-size: 24px; font-weight: 400; }
    .module-toggle::before { content: "+"; }
    .course-module[open] .module-toggle::before { content: "−"; }
    .course-module[open] { background: #edf1f6; }
    .module-body { padding: 0 60px 26px 62px; max-width: 910px; font-size: 13px; }
    .module-body p { margin-bottom: 15px; color: var(--muted); }
    .module-body .module-topics { color: var(--blue); font-size: 11px; font-weight: 700; }
    .module-body strong { color: var(--ink); }
    .concept-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 36px; margin: 0; }
    .concept { border-top: 2px solid #b9c9dc; padding: 22px 0 32px; }
    .concept dt { font-size: 16px; margin-bottom: 15px; line-height: 1.5; }
    .concept dt > span { display: block; color: #607791; font-size: 10px; letter-spacing: 1px; margin-bottom: 9px; }
    .concept dd { font-size: 13px; color: var(--muted); margin: 0; }
    .concept .concept-example { margin-top: 13px; color: var(--blue); font-size: 12px; }
    .format-lab { display: grid; grid-template-columns: 1fr 1.5fr; gap: 40px; margin-top: 20px; padding: 30px; background: #e7edf5; }
    .format-intro h3 { font-size: 24px; margin-bottom: 18px; }
    .format-intro > p:last-child { font-size: 13px; color: var(--muted); }
    .format-examples { min-width: 0; }
    .format-example { border-bottom: 1px solid #bdcada; }
    .format-example:first-child { border-top: 1px solid #bdcada; }
    .format-example summary { display: flex; justify-content: space-between; list-style: none; cursor: pointer; padding: 12px 0; color: var(--blue); font-weight: 700; }
    .format-example[open] summary span { transform: rotate(45deg); }
    .format-example > p { font-size: 12px; color: var(--muted); margin-bottom: 12px; }
    .format-example pre { background: #f9fafc; border: 1px solid #c8d3df; border-radius: 0; padding: 16px; font-size: 11px; line-height: 1.7; color: #263749; margin: 0 0 18px; overflow-x: auto; }
    .practice-list { margin: 0; padding: 0; list-style: none; }
    .practice-list li { display: flex; gap: 25px; border-top: 1px solid var(--line); padding: 27px 0; }
    .practice-number { color: var(--blue); font-size: 12px; font-weight: 700; padding-top: 4px; flex-shrink: 0; }
    .practice-list h3 { font-size: 18px; margin-bottom: 10px; }
    .practice-list li > div { max-width: 740px; }
    .practice-list p { color: var(--muted); font-size: 13px; margin-bottom: 10px; }
    .practice-list .practice-output { color: var(--blue); font-size: 12px; margin: 0; }
    .practice-label { margin-left: auto; padding-top: 4px; font-size: 10px; color: #66778b; letter-spacing: 1px; }
    .research-check { padding: 24px 0 0 42px; border-top: 1px solid var(--line); }
    .research-check h3 { font-size: 16px; margin-bottom: 10px; }
    .research-check p { font-size: 13px; color: var(--muted); max-width: 820px; }
    .resource-notice { display: flex; gap: 12px; background: #e7edf5; padding: 17px 20px; color: #42556c; font-size: 12px; margin-bottom: 25px; }
    .resource-notice i { color: var(--blue); padding-top: 4px; }
    .resource-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px; }
    .resource-filters button { background: transparent; border: 1px solid #c3cddb; color: var(--blue); padding: 8px 12px; font: inherit; font-size: 11px; font-weight: 700; }
    .resource-filters button:hover { background: #e7edf5; }
    .resource-filters button[aria-pressed="true"] { color: #fff; background: var(--blue); border-color: var(--blue); }
    .resource-filters button span { margin-left: 7px; opacity: 0.8; }
    .resource-status { color: var(--muted); font-size: 11px; margin-bottom: 27px; }
    .resource-group { margin-bottom: 35px; }
    .resource-group:last-child { margin-bottom: 0; }
    .resource-group > h3 { font-size: 19px; margin-bottom: 17px; }
    .resource-row { display: grid; grid-template-columns: 80px 1fr 150px; gap: 22px; align-items: start; border-top: 1px solid var(--line); padding: 20px 0; }
    .resource-row:target { outline: 2px solid #7d9fd3; outline-offset: 7px; background: #edf1f6; }
    .resource-format { color: var(--blue); font-size: 10px; font-weight: 700; letter-spacing: 0.4px; padding-top: 3px; }
    .resource-description { min-width: 0; }
    .resource-description h4 { font-size: 15px; margin-bottom: 7px; }
    .resource-description > p { color: var(--muted); font-size: 12px; max-width: 730px; }
    .resource-description .resource-meta { font-size: 10px; margin-top: 8px; color: #5b6b7e; overflow-wrap: anywhere; }
    .resource-meta code { color: #526780; background: transparent; padding: 0; font-size: 10px; white-space: normal; }
    .resource-meta span { padding: 0 5px; }
    .resource-placeholder, .resource-download { display: inline-flex; align-items: center; justify-content: end; gap: 7px; font-size: 10px; padding-top: 3px; white-space: nowrap; }
    .resource-placeholder { color: #5b6b7e; }
    .course-page [hidden] { display: none !important; }
    .course-end { display: flex; align-items: center; justify-content: space-between; gap: 25px; padding: 32px 0 40px; }
    .course-end p { font-size: 13px; color: var(--muted); }
    @media (max-width: 991px) {
        .course-hero { gap: 30px; grid-template-columns: 1.3fr 1fr; }
        .course-note { padding: 22px; }
        .course-note h2 { font-size: 22px; }
        .course-nav-inner { gap: 22px; }
        .overview-section { grid-template-columns: 1fr 1.2fr; gap: 35px; }
        .concept-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .format-lab { grid-template-columns: 1fr 1.4fr; gap: 25px; }
        .practice-list li > div { max-width: 560px; }
        .practice-label { display: none; }
        .resource-row { grid-template-columns: 60px 1fr 125px; gap: 15px; }
    }
    @media (max-width: 767px) {
        .course-back { margin: 20px 0 24px; }
        .course-hero { grid-template-columns: 1fr; padding-bottom: 32px; }
        .course-hero h1 { font-size: 38px; letter-spacing: -1px; }
        .hero-description { font-size: 15px; margin: 20px 0 25px; }
        .course-note h2 br { display: none; }
        .course-note h2 { max-width: 400px; }
        .course-note { padding: 22px; }
        .course-note dl { font-size: 12px; }
        .course-nav-inner { gap: 6px 20px; padding-block: 9px; min-height: 0; }
        .course-nav span { display: none; }
        .course-nav a { padding-block: 4px; font-size: 11px; }
        .course-section { padding: 40px 0; }
        .overview-section, .format-lab { grid-template-columns: 1fr; gap: 25px; }
        .section-heading { display: block; margin-bottom: 25px; }
        .section-heading > p { margin-top: 17px; max-width: 540px; }
        .section-heading h2, .section-intro h2 { font-size: 25px; }
        .section-intro h2 br { display: none; }
        .module-title strong { font-size: 16px; }
        .course-module summary { gap: 10px; padding: 20px 0; }
        .module-body { padding: 0 18px 22px 45px; }
        .concept-grid { gap: 0 25px; }
        .concept { padding-bottom: 25px; }
        .format-lab { padding: 23px; }
        .practice-list li { gap: 18px; }
        .research-check { padding-left: 33px; }
        .resource-row { grid-template-columns: 55px minmax(0, 1fr); gap: 8px 15px; padding-block: 20px; }
        .resource-placeholder, .resource-download { grid-column: 2; justify-content: start; padding-top: 3px; }
        .course-end { align-items: start; }
