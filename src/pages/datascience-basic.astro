        .course-note h2 { font-size: 20px; }
        .course-end { flex-direction: column; gap: 12px; }
        .course-end p { max-width: none; }
    }
</style>

<script>
    const library = document.querySelector<HTMLElement>("#resources");
    if (library) {
        const filters = library.querySelectorAll<HTMLButtonElement>("[data-resource-filter]");
        const groups = library.querySelectorAll<HTMLElement>("[data-resource-group]");
        const status = library.querySelector<HTMLElement>("#resource-status");

        const showCategory = (category: string) => {
            let count = 0;
            let label = "all resources";
            groups.forEach((group) => {
                group.hidden = category !== "all" && group.dataset.resourceGroup !== category;
                if (!group.hidden) {
                    count += group.querySelectorAll(".resource-row").length;
                    if (category !== "all") label = group.querySelector("h3")?.textContent?.toLowerCase() ?? "resources";
                }
            });
            filters.forEach((filter) => filter.setAttribute("aria-pressed", String(filter.dataset.resourceFilter === category)));
            if (status) status.textContent = category === "all" ? `Showing all ${count} resources.` : `Showing ${count} resources in ${label}.`;
        };

        filters.forEach((filter) => filter.addEventListener("click", () => showCategory(filter.dataset.resourceFilter ?? "all")));
        const controls = library.querySelector<HTMLElement>(".resource-filters");
        if (controls) controls.hidden = false;

        // A direct link to a resource must also reveal its category after filtering.
        const revealLinkedResource = () => {
            const target = document.getElementById(window.location.hash.slice(1));
            if (target && library.contains(target) && target.closest<HTMLElement>("[data-resource-group]")?.hidden) {
                showCategory("all");
                target.scrollIntoView({ block: "start" });
            }
        };
        window.addEventListener("hashchange", revealLinkedResource);
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#resource-"]').forEach((link) => {
            link.addEventListener("click", () => {
                const target = document.getElementById(link.hash.slice(1));
                if (target?.closest<HTMLElement>("[data-resource-group]")?.hidden) showCategory("all");
            });
        });
        revealLinkedResource();
    }
</script>
