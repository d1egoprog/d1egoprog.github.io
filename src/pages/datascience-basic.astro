---
import MainLayout from "../layouts/MainLayout.astro";
import { sitePath } from "../lib/urls";
import { courseModules, courseResources, resourceCategories } from "../data/datascience-basic";

---

<MainLayout
    title="Data Science Basics"
    description="Data science and data management for doctoral research. Explore the course outline, slides, Python notebooks, code, and dataset examples."
    pageType="CollectionPage"
>
    <div class="course-page" id="course-top">
        <div class="container">
            <a class="course-back" href={sitePath("teaching/")}><span aria-hidden="true">←</span> Teaching</a>
            <header class="course-hero">
                <div>
                    <p class="eyebrow">datascience-basic</p>
                    <h1>Data Science<br /><span>for doctoral research</span></h1>
                    <p class="hero-description">A practical introduction to understanding, preparing, and learning from data. Connect the core concepts to your own research question.</p>
                    <div class="hero-actions">
                        <a class="course-button" href="#course-outline">Explore the course <span aria-hidden="true">↓</span></a>
                        <a class="text-link" href="#resources">Browse resources <span aria-hidden="true">↗</span></a>
                    </div>
                </div>
                <aside class="course-note" aria-label="Course information">
                    <span class="note-index" aria-hidden="true">01 / RESEARCH NOTEBOOK</span>
                    <h2>A question.<br /> A dataset.<br /> An informed conclusion.</h2>
                    <p>Bring a question from your field. Work through the choices that make data useful as research evidence.</p>
                    <dl>
                        <div><dt>Instructor</dt><dd>Diego Rincon-Yanez</dd></div>
                        <div><dt>Focus</dt><dd>Data science & data management</dd></div>
                        <div><dt>Approach</dt><dd>Concepts + hands-on practice</dd></div>
                    </dl>
                </aside>
            </header>
        </div>

        <nav class="course-nav" aria-label="On this page">
            <div class="container course-nav-inner">
                <span>On this page</span>
                <a href="#overview">Overview</a>
                <a href="#course-outline">Course outline</a>
                <a href="#resources">Resources</a>
            </div>
        </nav>

        <div class="container course-content">
            <section class="course-section overview-section" id="overview" aria-labelledby="overview-heading">
                <div class="section-intro">
                    <p class="eyebrow">The starting point</p>
                    <h2 id="overview-heading">Good research starts<br /> with understanding your data</h2>
                </div>
                <div class="overview-copy">
                    <p>This course brings together the foundations of data science and the practical work of data management. We begin with a research question, examine the data behind it, and explore how analysis can support a defensible interpretation.</p>
                    <p>You will work with data formats, cleaning decisions, introductory AI, and text analysis. Documentation, visualization, and responsible reuse run through the course.</p>
                    <h3>What you will practice</h3>
                    <ul class="check-list">
                        <li>Describe a dataset, its origin, and its limitations.</li>
                        <li>Recognize common formats and prepare data for analysis.</li>
                        <li>Explain the purpose of a model and how to evaluate it.</li>
                        <li>Communicate a simple analysis with a clear chart and reproducible steps.</li>
                    </ul>
                    <p class="course-expectation"><strong>Before you begin:</strong> bring basic computer skills, an interest in research, and a willingness to experiment. The practical work introduces Python and notebooks step by step.</p>
                </div>
            </section>

            <section class="course-section" id="course-outline" aria-labelledby="outline-heading">
                <div class="section-heading">
                    <div><p class="eyebrow">The learning path</p><h2 id="outline-heading">Course outline</h2></div>
                    <p>Five topics, with a research activity for each. Open a topic to see what we will cover.</p>
                </div>
                <div class="module-list">
                    {courseModules.map((module, index) => (
                        <details class="course-module" open={index === 0}>
                            <summary>
                                <span class="module-number">{module.number}</span>
                                <span class="module-title"><strong>{module.title}</strong><span>{module.summary}</span></span>
                                <span class="module-toggle" aria-hidden="true"></span>
                            </summary>
                            <div class="module-body">
                                <p class="module-topics">{module.topics}</p>
                                <p>{module.learning}</p>
                                <p><strong>Research activity.</strong> {module.activity}</p>
                                <a class="text-link" href={`#resource-${module.resource}`}>Find the slides in resources <span aria-hidden="true">↗</span></a>
                            </div>
                        </details>
                    ))}
                </div>
            </section>

            <section class="course-section resource-section" id="resources" aria-labelledby="resources-heading">
                <div class="section-heading">
                    <div><p class="eyebrow">Keep learning</p><h2 id="resources-heading">Course resources</h2></div>
                    <p>Slides, Python notebooks and code, plus file examples.</p>
                </div>
                <p class="resource-notice"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span><strong>Download links are coming soon.</strong> The library reserves a place for each resource. Selected datasets and code carry over from the earlier Big Data course.</span></p>
                <div class="resource-filters" role="group" aria-label="Filter course resources" hidden>
                    <button type="button" data-resource-filter="all" aria-pressed="true">All resources <span>{courseResources.length}</span></button>
                    {resourceCategories.map((category) => (
                        <button type="button" data-resource-filter={category.id} aria-pressed="false">{category.label} <span>{courseResources.filter((resource) => resource.category === category.id).length}</span></button>
                    ))}
                </div>
                <p class="resource-status" id="resource-status" role="status" aria-live="polite" aria-atomic="true">Showing all {courseResources.length} resources.</p>
                <div class="resource-groups">
                    {resourceCategories.map((category) => (
                        <section class="resource-group" data-resource-group={category.id} aria-labelledby={`group-${category.id}`}>
                            <h3 id={`group-${category.id}`}>{category.label}</h3>
                            <ul class={category.id === "datasets" ? "dataset-list" : "resource-list"}>
                                {courseResources.filter((resource) => resource.category === category.id).map((resource) => (
                                    category.id === "datasets" ? (
                                        <li class="dataset-item" data-resource-item id={`resource-${resource.id}`}>
                                            <span class="dataset-format">{resource.format}</span>
                                            {resource.href ? (
                                                <a class="dataset-name" href={resource.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${resource.title}`}>{resource.title} <span aria-hidden="true">↗</span></a>
                                            ) : (
                                                <span class="dataset-name">{resource.title}</span>
                                            )}
                                            <code class="dataset-filename">{resource.filename}</code>
                                        </li>
                                    ) : (
                                        <li class="resource-row" data-resource-item id={`resource-${resource.id}`}>
                                            <span class="resource-format">{resource.format}</span>
                                            <div class="resource-description">
                                                <h4>{resource.title}</h4>
                                                <p>{resource.description}</p>
                                                <p class="resource-meta">{resource.origin}{resource.filename && <> <span aria-hidden="true">/</span> <code>{resource.filename}</code></>}</p>
                                            </div>
                                            {resource.href ? (
                                                <a class="resource-download" href={resource.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${resource.title}`}><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Open resource</a>
                                            ) : (
                                                <span class="resource-placeholder"><i class="fa-solid fa-clock" aria-hidden="true"></i> Link coming soon</span>
                                            )}
                                        </li>
                                    )
                                ))}
                            </ul>
                        </section>
                    ))}
                </div>
            </section>

            <div class="course-end"><p>Bring your questions. Read, discuss, and practice.</p><a class="text-link" href="#course-top">Back to top <span aria-hidden="true">↑</span></a></div>
        </div>
    </div>
</MainLayout>

<style>
    .course-page { --ink: #263749; --muted: #576575; --blue: #24486e; --line: #ccd4dd; color: var(--ink); background: #f6f7f9; font-size: 15px; line-height: 1.6; }
    .course-page :is(section, li[id], div[id]) { scroll-margin-top: 60px; }
    .course-page h1, .course-page h2, .course-page h3, .course-page h4 { font-family: "Raleway", sans-serif; font-weight: 700; line-height: 1.25; }
    .course-page a { color: var(--blue); }
    .course-page a:hover { text-decoration: underline; }
    .course-page :is(a, button, summary):focus-visible { outline: 3px solid #315e90; outline-offset: 5px; }
    .course-back { display: inline-flex; gap: 8px; margin: 12px 0; font-size: 13px; }
    .eyebrow { color: var(--blue); font-size: 11px; font-weight: 700; letter-spacing: 1.7px; text-transform: uppercase; margin-bottom: 6px; }
    .course-hero { display: grid; grid-template-columns: 1.45fr 1fr; gap: 28px; padding-bottom: 24px; align-items: center; }
    .course-hero h1 { font-size: clamp(32px, 3.6vw, 49px); letter-spacing: -1.4px; line-height: 1.15; }
    .course-hero h1 span { color: var(--blue); }
    .hero-description { max-width: 550px; color: var(--muted); margin: 12px 0 14px; font-size: 17px; }
    .hero-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .course-button { display: inline-flex; align-items: center; gap: 18px; background: var(--blue); color: #fff !important; font-weight: 700; padding: 10px 16px; font-size: 13px; }
    .course-button:hover { background: #1b3856; text-decoration: none !important; }
    .text-link { font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; gap: 9px; }
    .course-note { background: #e7edf5; border-top: 3px solid #7d9fd3; padding: 14px 16px; }
    .note-index { display: block; font-size: 10px; color: #526780; letter-spacing: 1px; margin-bottom: 8px; }
    .course-note h2 { font-size: 22px; line-height: 1.25; margin-bottom: 8px; }
    .course-note h2 br { display: none; }
    .course-note > p { color: var(--muted); font-size: 13px; line-height: 1.6; margin-bottom: 10px; }
    .course-note dl { margin: 0; border-top: 1px solid #c5cfdb; padding-top: 8px; font-size: 11px; line-height: 1.6; }
    .course-note dl div { display: grid; grid-template-columns: 75px minmax(0, 1fr); gap: 8px; padding: 2px 0; }
    .course-note dt { color: #526175; font-weight: 400; }
    .course-note dd { font-weight: 700; margin: 0; }
    .course-nav { position: sticky; top: 0; z-index: 20; background: #fff; border-block: 1px solid var(--line); }
    .course-nav-inner { display: flex; align-items: center; gap: 20px; min-height: 44px; flex-wrap: wrap; }
    .course-nav span { color: #697584; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin-right: auto; }
    .course-nav a { font-size: 12px; font-weight: 700; padding-block: 8px; }
    .course-section { padding: 28px 0; border-bottom: 1px solid var(--line); }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 14px; }
    .section-heading h2, .section-intro h2 { font-size: 27px; letter-spacing: -0.5px; }
    .section-heading > p { color: var(--muted); max-width: 390px; font-size: 13px; }
    .overview-section { display: grid; grid-template-columns: 0.9fr 1.5fr; gap: 28px; }
    .overview-copy > p { margin-bottom: 10px; color: var(--muted); }
    .overview-copy h3 { font-size: 17px; margin: 12px 0 8px; }
    .check-list { margin: 0 0 12px; }
    .check-list li { position: relative; padding-left: 20px; margin-bottom: 3px; font-size: 13px; }
    .check-list li::before { content: "✓"; position: absolute; left: 0; color: var(--blue); }
    .overview-copy .course-expectation { font-size: 12px; margin-bottom: 0; }
    .course-module { border-top: 1px solid var(--line); }
    .course-module:last-child { border-bottom: 1px solid var(--line); }
    .course-module summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 10px 5px; line-height: 1.4; }
    .course-module summary::-webkit-details-marker { display: none; }
    .module-number { font-size: 12px; font-weight: 700; color: var(--blue); width: 28px; flex-shrink: 0; }
    .module-title { display: flex; align-items: baseline; flex-wrap: wrap; gap: 2px 12px; min-width: 0; }
    .module-title strong { font-size: 17px; }
    .module-title > span { color: var(--muted); font-size: 12px; }
    .module-toggle { margin-left: auto; width: 22px; flex-shrink: 0; color: var(--blue); text-align: center; font-size: 22px; font-weight: 400; line-height: 1; }
    .module-toggle::before { content: "+"; }
    .course-module[open] .module-toggle::before { content: "−"; }
    .course-module[open] { background: #edf1f6; }
    .module-body { padding: 0 36px 12px 45px; max-width: 910px; font-size: 13px; }
    .module-body p { margin-bottom: 7px; color: var(--muted); }
    .module-body .module-topics { color: var(--blue); font-size: 11px; font-weight: 700; }
    .module-body strong { color: var(--ink); }
    .resource-notice { display: flex; gap: 8px; background: #e7edf5; padding: 10px 12px; color: #42556c; font-size: 12px; margin-bottom: 12px; }
    .resource-notice i { color: var(--blue); padding-top: 4px; }
    .resource-filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
    .resource-filters button { background: transparent; border: 1px solid #c3cddb; color: var(--blue); padding: 8px 12px; font: inherit; font-size: 11px; font-weight: 700; }
    .resource-filters button:hover { background: #e7edf5; }
    .resource-filters button[aria-pressed="true"] { color: #fff; background: var(--blue); border-color: var(--blue); }
    .resource-filters button span { margin-left: 7px; opacity: 0.8; }
    .resource-status { color: var(--muted); font-size: 11px; margin-bottom: 12px; }
    .resource-group { margin-bottom: 18px; }
    .resource-group:last-child { margin-bottom: 0; }
    .resource-group > h3 { font-size: 18px; margin-bottom: 8px; }
    .resource-row { display: grid; grid-template-columns: 64px minmax(0, 1fr) 130px; gap: 12px; align-items: start; border-top: 1px solid var(--line); padding: 9px 0; }
    [data-resource-item]:target { outline: 2px solid #7d9fd3; outline-offset: 7px; background: #edf1f6; }
    .resource-format { color: var(--blue); font-size: 10px; font-weight: 700; letter-spacing: 0.4px; padding-top: 3px; }
    .resource-description { min-width: 0; }
    .resource-description h4 { font-size: 15px; margin-bottom: 4px; }
    .resource-description > p { color: var(--muted); font-size: 12px; max-width: 730px; }
    .resource-description .resource-meta { font-size: 10px; margin-top: 4px; color: #5b6b7e; overflow-wrap: anywhere; }
    .resource-meta code { color: #526780; background: transparent; padding: 0; font-size: 10px; white-space: normal; }
    .resource-meta span { padding: 0 5px; }
    .resource-placeholder, .resource-download { display: inline-flex; align-items: center; justify-content: end; gap: 7px; font-size: 10px; padding-top: 3px; white-space: nowrap; }
    .resource-placeholder { color: #5b6b7e; }
    .dataset-list { margin: 0; padding: 0; list-style: none; }
    .dataset-item { display: grid; grid-template-columns: 65px minmax(0, 1fr) minmax(0, 1fr); align-items: baseline; gap: 4px 12px; padding: 4px 0; border-top: 1px solid var(--line); font-size: 12px; }
    .dataset-format { color: var(--blue); font-size: 10px; font-weight: 700; }
    .dataset-name { font-weight: 700; }
    .dataset-filename { color: var(--muted); background: transparent; padding: 0; font-size: 10px; white-space: normal; overflow-wrap: anywhere; }
    .course-page [hidden] { display: none !important; }
    .course-end { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 0 20px; }
    .course-end p { font-size: 13px; color: var(--muted); }
    @media (max-width: 991px) {
        .course-hero { gap: 20px; grid-template-columns: 1.3fr 1fr; }
        .course-note { padding: 14px; }
        .course-note h2 { font-size: 21px; }
        .course-nav-inner { gap: 16px; }
        .overview-section { grid-template-columns: 1fr 1.5fr; gap: 20px; }
        .resource-row { grid-template-columns: 55px minmax(0, 1fr) 115px; gap: 10px; }
    }
    @media (max-width: 767px) {
        .course-back { margin: 10px 0 12px; }
        .course-hero { grid-template-columns: 1fr; gap: 16px; padding-bottom: 18px; }
        .course-hero h1 { font-size: 38px; letter-spacing: -1px; }
        .hero-description { font-size: 15px; margin: 10px 0 12px; }
        .course-note h2 { max-width: 400px; }
        .course-note { padding: 14px; }
        .course-note dl { font-size: 12px; }
        .course-nav-inner { gap: 4px 18px; padding-block: 6px; min-height: 44px; }
        .course-nav span { display: none; }
        .course-nav a { padding-block: 4px; font-size: 11px; }
        .course-section { padding: 20px 0; }
        .overview-section { grid-template-columns: 1fr; gap: 12px; }
        .section-heading { display: block; margin-bottom: 12px; }
        .section-heading > p { margin-top: 6px; max-width: 540px; }
        .section-heading h2, .section-intro h2 { font-size: 25px; }
        .section-intro h2 br { display: none; }
        .module-title strong { font-size: 16px; }
        .course-module summary { gap: 8px; padding: 9px 0; }
        .module-title { display: grid; gap: 2px; }
        .module-body { padding: 0 12px 10px 36px; }
        .resource-row { grid-template-columns: 45px minmax(0, 1fr); gap: 4px 10px; padding-block: 9px; }
        .resource-placeholder, .resource-download { grid-column: 2; justify-content: start; padding-top: 3px; }
        .dataset-item { grid-template-columns: 55px minmax(0, 1fr); gap: 0 10px; }
        .dataset-filename { grid-column: 2; }
        .course-end { align-items: start; }
        .course-end p { max-width: 240px; }
        .course-end a { white-space: nowrap; }
    }
    @media (max-width: 420px) {
        .course-hero h1 { font-size: 31px; }
        .hero-actions { gap: 12px; }
        .course-nav-inner { column-gap: 16px; }
        .course-note h2 { font-size: 20px; }
        .course-end { flex-direction: column; gap: 12px; }
        .course-end p { max-width: none; }
    }
</style>

<script>
    const library = document.querySelector<HTMLElement>("#resources");
    if (library) {
        const filters = library.querySelectorAll<HTMLButtonElement>("[data-resource-filter]");
        const groups = library.querySelectorAll<HTMLElement>("[data-resource-group]");
        const status = library.querySelector<HTMLElement>("#resource-status");

        const showCategory = (category: string) => {
            let count = 0;
            let label = "all resources";
            groups.forEach((group) => {
                group.hidden = category !== "all" && group.dataset.resourceGroup !== category;
                if (!group.hidden) {
                    count += group.querySelectorAll("[data-resource-item]").length;
                    if (category !== "all") label = group.querySelector("h3")?.textContent?.toLowerCase() ?? "resources";
                }
            });
            filters.forEach((filter) => filter.setAttribute("aria-pressed", String(filter.dataset.resourceFilter === category)));
            if (status) status.textContent = category === "all" ? `Showing all ${count} resources.` : `Showing ${count} resources in ${label}.`;
        };

        filters.forEach((filter) => filter.addEventListener("click", () => showCategory(filter.dataset.resourceFilter ?? "all")));
        const controls = library.querySelector<HTMLElement>(".resource-filters");
        if (controls) controls.hidden = false;

        // A direct link to a resource must also reveal its category after filtering.
        const revealLinkedResource = () => {
            const target = document.getElementById(window.location.hash.slice(1));
            if (target && library.contains(target) && target.closest<HTMLElement>("[data-resource-group]")?.hidden) {
                showCategory("all");
                target.scrollIntoView({ block: "start" });
            }
        };
        window.addEventListener("hashchange", revealLinkedResource);
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#resource-"]').forEach((link) => {
            link.addEventListener("click", () => {
                const target = document.getElementById(link.hash.slice(1));
                if (target?.closest<HTMLElement>("[data-resource-group]")?.hidden) showCategory("all");
            });
        });
        revealLinkedResource();
    }
</script>
