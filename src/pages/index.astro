---
import { sitePath } from "../lib/urls";
import MainLayout from "../layouts/MainLayout.astro";

const selectedResearch = [
    {
        year: "2024",
        title: "Scaling Scientific Knowledge Discovery with Neuro-Symbolic AI and Large Language Models",
        venue: "SKGI workshop at SEMANTiCS",
        bib: "2024-SKGI.bib",
        paper: "https://ceur-ws.org/Vol-3759/workshop4.pdf",
        code: "https://github.com/d1egoprog/KG-SLR4LLM",
    },
    {
        year: "2023",
        title: "Enhancing downstream tasks in Knowledge Graphs Embeddings: A Complement Graph-based Approach Applied to Bilateral Trade",
        venue: "Procedia Computer Science",
        bib: "2023-KES.bib",
        paper: "https://doi.org/10.1016/j.procs.2023.10.364",
        code: "https://github.com/d1egoprog/SyntheticTriples",
    },
    {
        year: "2023",
        title: "Accurate prediction of international trade flows: Leveraging knowledge graphs and their embeddings",
        venue: "Journal of King Saud University · Computer and Information Sciences",
        bib: "2023-JKSUCI.bib",
        paper: "https://doi.org/10.1016/j.jksuci.2023.101789",
    },
    {
        year: "2022",
        title: "FAIR Knowledge Graph construction from text, an approach applied to fictional novels",
        venue: "TEXT2KG workshop at ESWC",
        bib: "2022-ESWC.bib",
        paper: "http://ceur-ws.org/Vol-3184/TEXT2KG_Paper_7.pdf",
        code: "https://github.com/d1egoprog/Text2KG",
    },
];

---
<MainLayout
    title=""
    description="Diego Rincon-Yanez researches Knowledge Graphs and Neuro-Symbolic AI. Explore his publications, research projects, and academic experience."
    pageType="ProfilePage"
>

<section class="container index_area" id="index">
    <header class="home-heading">
        <p class="home-eyebrow">Diego Rincon-Yanez</p>
        <h1>Knowledge Graphs &amp; Neuro-Symbolic AI</h1>
    </header>
    <div class="home-main">
        <div class="index_item">
            <h2>Research focus</h2>
            <p class="presentation">My work combines Semantic Web technologies, Knowledge Graphs, and embeddings for knowledge discovery, semantic integration, and knowledge base construction. I focus on methods that connect research with practical applications.</p>
            <p class="presentation">I welcome collaborations with researchers, industry professionals, and academic institutions working on Knowledge Graphs, Neuro-Symbolic AI, and related topics.</p>
        </div>             
        <div class="index_item">
            <h2>News, Updates and Notes</h2> 
            <h3>Industry Sabbatical at Bosch Research</h3>
            <p><strong>Date:</strong> May 2024</p>
            <p>Learn more about my time at the Bosch Research Center in Renningen, Germany, where I worked  into the integration of 
                symbolic AI and neural AI (Neuro-Symbolic AI) in Smart Manufacturing Scenarios, I had the opportunity to work with top researchers, 
                participate in EU projects like <a href="https://datacloudproject.eu/" target="_blank">DataCloud</a>, and explore cutting-edge developments in AI. Check out the full note for more details on my experience</p>
            <a href="https://www.bosch.com/stories/industry-sabbatical-at-bosch-research/" target="_blank">Click here to read the full note</a>
        </div>                        
        <section class="index_item selected-research" aria-labelledby="selected-heading">
            <h2 id="selected-heading">Selected Research and Projects</h2>
            <ol class="selected-list">
                {selectedResearch.map((item) => (
                    <li>
                        <span class="selected-year">{item.year}</span>
                        <div class="selected-entry">
                            <h3><a href={item.paper} target="_blank" rel="noopener noreferrer">{item.title}</a></h3>
                            <div class="selected-meta">
                            <p class="selected-venue">{item.venue}</p>
                            <div class="selected-links">
                                <a href={item.paper} target="_blank" rel="noopener noreferrer" aria-label={`Read ${item.title}`}>Paper</a>
                                <a href={sitePath(`bibtex/${item.bib}`)} aria-label={`BibTeX for ${item.title}`}>BibTeX</a>
                                {item.code && <a href={item.code} target="_blank" rel="noopener noreferrer" aria-label={`Source code for ${item.title}`}>Code</a>}
                            </div>
                            </div>
                        </div>
                    </li>
                ))}
            </ol>
            <a class="all-research" href={sitePath("research/")}>All publications <span aria-hidden="true">→</span></a>
        </section>
    </div>
</section>

</MainLayout>

<style>
    #index { padding-top: 0; }
    .home-heading { padding: 34px 40px 26px; border-bottom: 1px solid #d6dce4; }
    #index .home-eyebrow { color: #526f9b; font-size: 12px; letter-spacing: 1px; padding-bottom: 12px; text-align: left; }
    .home-heading h1 { font-family: "Raleway", sans-serif; font-size: 30px; font-weight: 700; line-height: 1.3; color: #263749; margin: 0; }
    #index .home-main p { text-align: left; line-height: 1.8; }
    #index .home-main .presentation { font-size: 16px; line-height: 1.8; }
    .home-main { min-width: 0; padding: 15px 25px 30px; }
    .selected-list { list-style: none; margin: 0 0 18px; padding: 0; }
    #index .selected-research > h2 { font-size: 20px; padding-bottom: 8px; }
    .selected-list li { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 12px; padding: 12px 0; border-bottom: 1px solid #d4d9df; }
    .selected-year { color: #6a7889; font-size: 12px; line-height: 1.5; padding-top: 2px; }
    #index .selected-entry h3 { font-size: 15px; line-height: 1.5; font-weight: 600; text-transform: none; padding: 0; margin: 0 0 5px; }
    .selected-entry h3 a { color: #263749; }
    .selected-entry h3 a:hover { color: #24486e; text-decoration: underline; }
    .selected-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; }
    #index .selected-entry .selected-venue { font-size: 11px; line-height: 1.5; color: #687584; padding: 0; margin: 0; }
    .selected-links { display: flex; flex-wrap: wrap; gap: 16px; }
    .selected-links a, .all-research { color: #24486e; font-size: 12px; font-weight: 700; }
    .selected-links a:hover, .all-research:hover { text-decoration: underline; }
    .selected-research a:focus-visible { outline: 2px solid #24486e; outline-offset: 3px; }
    @media (max-width: 767px) {
        .home-heading { padding: 28px 15px 22px; }
        .home-heading h1 { font-size: 25px; }
        .home-main { padding: 10px 0 20px; }
    }
</style>
